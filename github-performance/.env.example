# Copy to .env (gitignored) and fill in. Real environment variables win over this file.
# Company GitHub organisation (the login in https://github.com/<org>)
GITHUB_ORG=your-org
# Default people to analyse: profile links or logins, comma separated
GITHUB_USERS=https://github.com/some-login,another-login
# Optional: extra people analysed in full, for the cohort comparison
# GITHUB_PEERS=login1,login2
# Optional: an org team slug whose members join the cohort
# GITHUB_TEAM=team-slug
# Token sources, first one GitHub accepts wins:
#   GITHUB_TOKEN -> Git Credential Manager -> GITHUB_PAT -> `gh auth token`
# Account of the github.com entry in Git Credential Manager (Windows Credential Manager).
# Needed when the store holds more than one github.com account.
# GITHUB_CREDENTIAL_USER=your-github-login
# GITHUB_TOKEN=
